{
  "name": "bhl",
  "displayName": "BHL",
  "publisher": "vscodebhl",
  "version": "0.5.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/bitdotgames/BHL"
  },
  "description": "BHL language support",
  "author": "BHL",
  "engines": {
    "vscode": "^1.79.0"
  },
  "categories": ["Programming Languages", "Debuggers"],
  "activationEvents": [
    "onLanguage:bhl",
    "onDebugResolve:bhl",
    "onCommand:bhl.selectProjectFile",
    "onCommand:bhl.useRepository",
    "onCommand:bhl.updateRepository",
    "onCommand:bhl.removeRepository"
  ],
  "main": "./out/extension",
  "contributes": {
    "languages": [
      {
        "id": "bhl",
        "aliases": ["BHL", "bhl"],
        "extensions": [".bhl"],
        "configuration": "./language-configuration.json"
      }
    ],
    "breakpoints": [
      { "language": "bhl" }
    ],
    "debuggers": [
      {
        "type": "bhl",
        "label": "BHL Debug",
        "configurationAttributes": {
          "attach": {
            "required": ["port"],
            "properties": {
              "host": {
                "type": "string",
                "description": "Host where the BHL debug server is running.",
                "default": "localhost"
              },
              "port": {
                "type": "number",
                "description": "Port the BHL debug server listens on.",
                "default": 7777
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "bhl",
            "request": "attach",
            "name": "Attach to BHL (Unity)",
            "host": "localhost",
            "port": 7777
          }
        ],
        "configurationSnippets": [
          {
            "label": "BHL Debug: Attach",
            "description": "Attach to a running BHL debug server (e.g. inside Unity Editor).",
            "body": {
              "type": "bhl",
              "request": "attach",
              "name": "Attach to BHL (Unity)",
              "host": "localhost",
              "port": 7777
            }
          }
        ]
      }
    ],
    "commands": [
      {
        "command": "bhl.reload",
        "title": "BHL: Reload Project"
      },
      {
        "command": "bhl.selectProjectFile",
        "title": "BHL: Select Project File"
      },
      {
        "command": "bhl.useRepository",
        "title": "BHL: Use internal LSP Server"
      },
      {
        "command": "bhl.updateRepository",
        "title": "BHL: Update internal LSP Server"
      },
      {
        "command": "bhl.removeRepository",
        "title": "BHL: Remove internal LSP Server"
      }
    ],
    "semanticTokenScopes": [
      {
        "scopes": {
          "class": ["entity.name.type.class"],
          "function": ["entity.name.function"],
          "variable": ["variable.other.readwrite"],
          "number": ["constant.numeric"],
          "string": ["string.quoted.double"],
          "type": ["entity.name.type"],
          "keyword": ["keyword.control"],
          "property": ["variable.other.property"],
          "operator": ["keyword.operator"],
          "parameter": ["variable.parameter"]
        }
      }
    ],
    "configurationDefaults": {
      "editor.semanticTokenColorCustomizations": {
        "rules": {
          "*.deprecated": {
            "strikethrough": true,
            "opacity": 0.6
          }
        }
      }
    },
    "configuration": {
      "title": "BHL",
      "properties": {
        "bhl.executablePath": {
          "type": "string",
          "default": "",
          "markdownDescription": "Path to the `bhl` executable. Defaults to `bhl` on PATH.\n\n- [Use internal LSP server](command:bhl.useRepository)\n- [Update internal LSP server](command:bhl.updateRepository)\n- [Remove internal LSP server](command:bhl.removeRepository)"
        },
        "bhl.logFile": {
          "type": "string",
          "default": "",
          "description": "Path to the LSP log file. If set, passes --log-file=<path> to the server."
        },
        "bhl.forceRebuild": {
          "type": "boolean",
          "default": false,
          "description": "Force full LSP server rebuild on startup by setting BHL_REBUILD=1. Useful for active LSP server development."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/vscode": "^1.79.0",
    "@types/node": "^16.18.0",
    "typescript": "^4.9.0"
  },
  "dependencies": {
    "vscode-languageclient": "^8.1.0"
  }
}
