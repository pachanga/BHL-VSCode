{
  "name": "bhl",
  "displayName": "BHL",
  "publisher": "vscodebhl",
  "version": "0.8.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/bitdotgames/BHL"
  },
  "description": "BHL language support",
  "author": "BHL",
  "icon": "images/icon.png",
  "engines": {
    "vscode": "^1.79.0"
  },
  "categories": ["Programming Languages", "Debuggers"],
  "activationEvents": [
    "onLanguage:bhl",
    "onDebugResolve:bhl",
    "onCommand:bhl.selectProjectFile",
    "onCommand:bhl.downloadRelease",
    "onCommand:bhl.removeDownloadedRelease"
  ],
  "main": "./out/extension",
  "contributes": {
    "languages": [
      {
        "id": "bhl",
        "aliases": ["BHL", "bhl"],
        "extensions": [".bhl"],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./images/icon.svg",
          "dark": "./images/icon.svg"
        }
      }
    ],
    "breakpoints": [
      { "language": "bhl" }
    ],
    "debuggers": [
      {
        "type": "bhl",
        "label": "BHL Debug",
        "configurationAttributes": {
          "attach": {
            "required": ["port"],
            "properties": {
              "host": {
                "type": "string",
                "description": "Host where the BHL debug server is running.",
                "default": "localhost"
              },
              "port": {
                "type": "number",
                "description": "Port the BHL debug server listens on.",
                "default": 7777
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "bhl",
            "request": "attach",
            "name": "Attach to BHL (Unity)",
            "host": "localhost",
            "port": 7777
          }
        ],
        "configurationSnippets": [
          {
            "label": "BHL Debug: Attach",
            "description": "Attach to a running BHL debug server (e.g. inside Unity Editor).",
            "body": {
              "type": "bhl",
              "request": "attach",
              "name": "Attach to BHL (Unity)",
              "host": "localhost",
              "port": 7777
            }
          }
        ]
      }
    ],
    "commands": [
      {
        "command": "bhl.reload",
        "title": "BHL: Reload Project"
      },
      {
        "command": "bhl.selectProjectFile",
        "title": "BHL: Select Project File"
      },
      {
        "command": "bhl.downloadRelease",
        "title": "BHL: Download LSP Release"
      },
      {
        "command": "bhl.removeDownloadedRelease",
        "title": "BHL: Remove Downloaded LSP Release"
      }
    ],
    "semanticTokenScopes": [
      {
        "scopes": {
          "class": ["entity.name.type.class"],
          "function": ["entity.name.function"],
          "variable": ["variable.other.readwrite"],
          "number": ["constant.numeric"],
          "string": ["string.quoted.double"],
          "type": ["entity.name.type"],
          "keyword": ["keyword.control"],
          "property": ["variable.other.property"],
          "operator": ["keyword.operator"],
          "parameter": ["variable.parameter"]
        }
      }
    ],
    "configurationDefaults": {
      "editor.semanticTokenColorCustomizations": {
        "rules": {
          "*.deprecated": {
            "strikethrough": true,
            "opacity": 0.6
          }
        }
      }
    },
    "configuration": {
      "title": "BHL",
      "properties": {
        "bhl.useCustomInstallation": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Use a custom BHL installation instead of a downloaded LSP release. When enabled, `bhl.executablePath` is used to launch the server; when disabled (default), the last release installed via **BHL: Download LSP Release** is used automatically."
        },
        "bhl.executablePath": {
          "type": "string",
          "default": "",
          "markdownDescription": "Path to a custom `bhl` executable. Only used when `bhl.useCustomInstallation` is enabled. Falls back to `bhl` on PATH if left empty.\n\n- [Download LSP release](command:bhl.downloadRelease)\n- [Remove downloaded LSP release](command:bhl.removeDownloadedRelease)"
        },
        "bhl.downloadedReleaseVersion": {
          "type": "string",
          "default": "",
          "markdownDescription": "Version of the currently downloaded LSP release, e.g. `v0.3.5` (empty if none). Managed automatically by **BHL: Download LSP Release** / **BHL: Remove Downloaded LSP Release** — not meant to be edited by hand."
        },
        "bhl.logFile": {
          "type": "string",
          "default": "",
          "description": "Path to the LSP log file. If set, passes --log-file=<path> to the server."
        },
        "bhl.forceRebuild": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Force full LSP server rebuild on startup by setting `BHL_REBUILD=1`. Only applies when `bhl.useCustomInstallation` is enabled. Useful for active LSP server development."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/vscode": "^1.79.0",
    "@types/node": "^16.18.0",
    "@types/adm-zip": "^0.5.8",
    "typescript": "^4.9.0"
  },
  "dependencies": {
    "vscode-languageclient": "^8.1.0",
    "adm-zip": "^0.6.0",
    "tar": "^7.5.20"
  }
}
